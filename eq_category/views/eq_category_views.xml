<odoo>

    <record id="view_eq_category_tree" model="ir.ui.view">
        <field name="name">eq.category.tree</field>
        <field name="model">eq.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="view_eq_category_form" model="ir.ui.view">
        <field name="name">eq.category.form</field>
        <field name="model">eq.category</field>
        <field name="arch" type="xml">
            <form string="Equipment Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eq_category" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="res_model">eq.category</field>
        <field name="view_mode">list,form</field>
    </record>

     <menuitem
        id="menu_eq_category"
        name="Equipment Categories"
        parent="stock.menu_stock_config_settings"
        action="action_eq_category"

    />



</odoo>
