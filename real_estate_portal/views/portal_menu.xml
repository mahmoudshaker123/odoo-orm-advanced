<odoo>
    <template id="portal_my_home_real_estate"
              inherit_id="portal.portal_my_home"
              priority="60"
              name="My Real Estate">

        <xpath expr="//div[@id='portal_service_category']" position="inside">

            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="''"/>
                <t t-set="title">My Real Estate</t>
                <t t-set="text">View and follow up your Real Estate</t>
                <t t-set="url" t-value="'/my/realestate'"/>
                <t t-set="placeholder_count" t-value="'real_estate_counts'"/>
                <t t-set="config_card" t-value="True"/>
            </t>

        </xpath>

    </template>

    <template id="portal_breadcrumbs_real_estate" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'real_estate_form_view'" class="breadcrumb-item">
                <a href="/my/realestate">Real Estate</a>
            </li>

            <li t-if="page_name == 'real_estate_form_view'" class="breadcrumb-item active">
                <t t-out="property.ref"/>
                -
                <t t-out="property.name"/>
            </li>

        </xpath>
    </template>


    <template id="real_estate_list_view_portal">
        <t t-call="portal.portal_layout">

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Real Estate</t>
                 <t t-set="default_url" t-value="'/my/realestate'"/>
                <t t-set="searchbar_inputs" t-value="searchbar_inputs"/>
                <t t-set="search_in" t-value="search_in"/>
                <t t-set="search" t-value="search"/>

                <t t-set="searchbar_sortings" t-value="searchbar_sortings"/>
                <t t-set="sortby" t-value="sortby"/>

                <t t-set="searchbar_groupby" t-value="searchbar_groupby"/>
                <t t-set="groupby" t-value="groupby"/>


            </t>

            <a href="/my/realestate/create" class="btn btn-primary mb-3">
    + Create Property
</a>
            <t t-call="portal.portal_table">

                <thead>
                    <tr class="text-center">
                        <th>Reference</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Owner</th>
                        <th>Selling Price</th>
                    </tr>
                </thead>

                <tbody>
<t t-foreach="grouped_data.items()" t-as="group">

    <tr class="table-secondary">
        <td colspan="5">
            <strong>
                <t t-out="group[0]"/>
            </strong>
        </td>
    </tr>

    <t t-foreach="group[1]" t-as="o">
        <tr>
            <td class="text-center">
                <a t-att-href="'/my/realestate/%s' % o.id">
                    <t t-out="o.ref"/>
                </a>
            </td>
            <td class="text-center">
                <t t-out="o.name"/>
            </td>
            <td class="text-center">
                <img t-if="o.image"
                     t-att-src="'/web/image/property/%s/image' % o.id"
                     style="width:60px; height:60px; object-fit:cover;"
                     class="rounded"/>
            </td>
            <td class="text-center">
                <t t-out="o.owner_id.name"/>
            </td>
            <td class="text-center">
                <t t-out="o.selling_price"/>
            </td>
        </tr>
    </t>

</t>                </tbody>

            </t>
        </t>
    </template>


    <template id="real_estate_form_view_portal">
        <t t-call="portal.portal_layout">

            <div class="container mt-4">
                      <a href="/my/realestate/create" class="btn btn-primary mb-3">
    + Create Property
</a>
                <div class="d-flex justify-content-between mb-3">

                    <div>
                        <a t-if="prev_id"
                           t-att-href="'/my/realestate/%s' % prev_id"
                           class="btn btn-outline-secondary">
                            ← Previous
                        </a>
                    </div>

                    <div>
                        <a t-if="next_id"
                           t-att-href="'/my/realestate/%s' % next_id"
                           class="btn btn-outline-secondary">
                            Next →
                        </a>
                    </div>

                </div>

                <div class="card">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <h4 class="mb-0 fw-bold">
                            <t t-out="property.name"/>
                        </h4>
                        <a t-att-href="'/my/realestate/%s/report' % property.id"
                           class="btn btn-primary">
                            Download PDF
                        </a>

                        <img t-if="property.image"
                             t-att-src="'/web/image/property/%s/image' % property.id"
                             class="rounded"
                             style="width:120px; height:120px; object-fit:cover;"/>

                    </div>

                    <div class="card-body">

                        <div class="row mb-3">
                            <div class="col-4">
                                <strong>Reference</strong>
                            </div>
                            <div class="col-8">
                                <t t-out="property.ref"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-4">
                                <strong>Owner</strong>
                            </div>
                            <div class="col-8">
                                <t t-out="property.owner_id.name"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-4">
                                <strong>Selling Price</strong>
                            </div>
                            <div class="col-8">
                                <t t-out="property.selling_price"/>
                            </div>
                        </div>

                        <div class="row mb-3">
    <div class="col-4">
        <strong>Available From</strong>
    </div>
    <div class="col-8">
<t t-out="property.date_availability" t-options="{'widget': 'date'}"/>
    </div>
</div>

<div class="row mb-3">
    <div class="col-4">
        <strong>Description</strong>
    </div>
    <div class="col-8">
        <t t-out="property.description"/>
    </div>
</div>

                    </div>

                </div>
                <div class="mt-4">
                    <h1>Chatter Feature</h1>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="property"/>
                    </t>

                </div>

            </div>

        </t>
    </template>

    <template id="create_property_form">
    <t t-call="portal.portal_layout">
<t t-if="error">
    <div class="alert alert-danger">
        <t t-esc="error"/>
    </div>
</t>
        <div class="container mt-4">
            <h2>Create Property</h2>

            <form action="/my/realestate/create/submit" method="post">

                <!-- CSRF -->
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3">
                    <label>Name</label>
<input type="text" name="name" class="form-control"
       t-att-value="values.get('name') if values else ''"/>
                </div>


                <div class="mb-3">
                    <label>Selling Price</label>
                    <input type="number" name="selling_price" class="form-control"/>
                </div>
                <div class="mb-3">
    <label>Postcode</label>
    <input type="text" name="postcode" class="form-control" required="1"/>
</div>
                <div class="mb-3">
    <label>Available From</label>
    <input type="date" name="date_availability" class="form-control"/>
</div>

<div class="mb-3">
    <label>Description</label>
    <textarea name="description" class="form-control" rows="4"></textarea>
</div>


              <div class="mb-3">
    <label>Owner</label>
    <select name="owner_id" class="form-control">
        <t t-foreach="owners" t-as="owner">
            <option t-att-value="owner.id">
                <t t-esc="owner.name"/>
            </option>
        </t>
    </select>
</div>
                <button type="submit" class="btn btn-primary">
                    Save
                </button>

            </form>
        </div>

    </t>
</template>
</odoo>