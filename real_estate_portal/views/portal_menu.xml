<odoo>
    <template id="portal_my_home_real_estate"
              inherit_id="portal.portal_my_home"
              priority="60"
              name="My Real Estate">

        <xpath expr="//div[@id='portal_service_category']" position="inside">

            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="''"/>
                <t t-set="title">My Real Estate</t>
                <t t-set="text">View and follow up your Real Estate</t>
                <t t-set="url" t-value="'/my/realestate'"/>
                <t t-set="placeholder_count" t-value="'real_estate_counts'"/>
                <t t-set="config_card" t-value="True"/>
            </t>

        </xpath>

    </template>
    <template id="real_estate_list_view">
        <t t-call="portal.portal_layout">
<table class="table table-striped">
                <thead>
                    <thead>
    <tr  class="text-center">
        <th>Reference</th>
        <th>Name</th>
        <th>Owner</th>
        <th>Selling Price</th>
    </tr>
</thead>
                </thead>
                <tbody>
                    <t t-foreach="real_estate" t-as="o">
                        <tr>
                            <td class="text-center">
                                <t t-out="o.ref"/>
                            </td>
                            <td class="text-center">
                                <t t-out="o.name"/>
                            </td>
                            <td class="text-center">
                                <t t-out="o.owner_id.name"/>
                            </td>
                            <td class="text-center">
                                <t t-out="o.selling_price"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>
</odoo>